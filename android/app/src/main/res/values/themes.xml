<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.GeorgePPM" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/accent</item>
        <item name="colorOnPrimary">#06222A</item>
        <item name="colorSecondary">@color/accentDim</item>
        <item name="android:colorBackground">@color/bg</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/textPrimary</item>
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:navigationBarColor">@color/bg</item>
    </style>

    <style name="MetricCard" parent="Widget.Material3.CardView.Filled">
        <item name="cardBackgroundColor">@color/surface</item>
        <item name="cardCornerRadius">18dp</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">@color/divider</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <style name="MetricLabel">
        <item name="android:textColor">@color/textMuted</item>
        <item name="android:textSize">12sp</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="android:textAllCaps">true</item>
    </style>

    <style name="MetricValue">
        <item name="android:textColor">@color/textPrimary</item>
        <item name="android:textSize">30sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="MetricValueSmall" parent="MetricValue">
        <item name="android:textSize">22sp</item>
    </style>

    <style name="MetricUnit">
        <item name="android:textColor">@color/textMuted</item>
        <item name="android:textSize">13sp</item>
    </style>
</resources>
